# UniFlow Backend — modèle d’environnement
# Ne commitez jamais le fichier .env réel.

NODE_ENV=production
PORT=3000
UNIFLOW_DATA_SOURCE=appwrite

# PostgreSQL accessible depuis le backend.
DATABASE_URL="postgresql://UTILISATEUR:MOT_DE_PASSE@HOTE:5432/NOM_BASE?sslmode=require"

JWT_SECRET="REMPLACEZ_PAR_UN_SECRET_ALEATOIRE_D_AU_MOINS_64_CARACTERES"
ENCRYPTION_KEY="REMPLACEZ_PAR_64_CARACTERES_HEX"
CORS_ALLOWED_ORIGINS="https://uniflow.kernelforge.codes,https://api-uniflow.kernelforge.codes"

# Appwrite Storage : bucket existant UniFlow.
APPWRITE_ENDPOINT="https://appwrite.kernelforge.codes/v1"
APPWRITE_PROJECT_ID="6a959096002a64d9d4e6"
APPWRITE_API_KEY="CLE_API_SERVEUR_APPWRITE"
APPWRITE_STORAGE_BUCKET_ID="uniflow_assets"

# Base Appwrite utilisée par les Functions et le web, si nécessaire.
# APPWRITE_DATABASE_ID="uniflow"

# Développement local :
# DATABASE_URL="postgresql://uniflow:uniflow_dev_password@localhost:5433/uniflow_dev"
# NODE_ENV=development
# CORS_ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173"
