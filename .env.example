# UniFlow Backend — modèle d'environnement.
# Ne commitez jamais le fichier .env réel.
#
# Le backend NestJS est hors service. Ce fichier ne sert plus qu'à porter la
# clé serveur Appwrite Cloud lue par les scripts de uniflow-we/scripts/
# (provisionnement, seeds, tests de bout en bout).

APPWRITE_ENDPOINT="https://fra.cloud.appwrite.io/v1"
APPWRITE_PROJECT_ID="uniflow"
APPWRITE_DATABASE_ID="uniflow"
APPWRITE_API_KEY="CLE_API_SERVEUR_APPWRITE"
APPWRITE_STORAGE_BUCKET_ID="uniflow_assets"

# --- Variables de l'ancien backend NestJS/Prisma, conservées pour référence ---
# NODE_ENV=production
# PORT=3000
# DATABASE_URL="postgresql://UTILISATEUR:MOT_DE_PASSE@HOTE:5432/NOM_BASE?sslmode=require"
# JWT_SECRET="..."
# ENCRYPTION_KEY="..."
# CORS_ALLOWED_ORIGINS="https://uniflow.kernelforge.codes"
