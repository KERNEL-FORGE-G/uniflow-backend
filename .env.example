# .env.example
#
# Copie ce fichier en .env et remplis les vraies valeurs.
# Ne JAMAIS commiter le fichier .env réel (déjà dans .gitignore).

# --- Local (Docker) — développement quotidien ---
DATABASE_URL="postgresql://uniflow:uniflow_dev_password@localhost:5433/uniflow_dev"

JWT_SECRET="dev-secret-uniflow-1234567890-changez-moi-en-prod"
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173"
PORT=3000

# --- Production / VPS ---
# NODE_ENV=production
# CORS_ALLOWED_ORIGINS="https://uniflow.kernelforge.codes,https://api-uniflow.kernelforge.codes"
