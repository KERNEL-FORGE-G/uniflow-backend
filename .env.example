# UniFlow Backend — modèle d’environnement
# Ne commitez jamais le fichier .env réel.
# Sur Vercel, ajoutez ces variables dans Project Settings > Environment Variables.

# ==================== OBLIGATOIRE ====================
NODE_ENV=production
PORT=3000

# PostgreSQL de production accessible depuis Vercel.
# Utilisez une URL avec SSL si votre fournisseur l’exige.
DATABASE_URL="postgresql://UTILISATEUR:MOT_DE_PASSE@HOTE:5432/NOM_BASE?sslmode=require"

# Secret long et aléatoire, différent de toute valeur de développement.
JWT_SECRET="REMPLACEZ_PAR_UN_SECRET_ALEATOIRE_D_AU_MOINS_64_CARACTERES"

# Clé AES-256 en hexadécimal (64 caractères hex) pour les données chiffrées.
ENCRYPTION_KEY="REMPLACEZ_PAR_64_CARACTERES_HEX"

# ==================== CORS ====================
# Liste séparée par des virgules, sans espace obligatoire.
CORS_ALLOWED_ORIGINS="https://uniflow.kernelforge.codes,https://api-uniflow.kernelforge.codes,https://uniflow-web.vercel.app"

# ==================== STOCKAGE FICHIERS ====================
# Obligatoire uniquement pour les routes d’upload de fichiers.
CLOUDINARY_CLOUD_NAME="VOTRE_CLOUD_NAME"
CLOUDINARY_API_KEY="VOTRE_CLOUDINARY_API_KEY"
CLOUDINARY_API_SECRET="VOTRE_CLOUDINARY_API_SECRET"

# ==================== APPWRITE (optionnel côté backend actuel) ====================
# Le backend NestJS actuel utilise Prisma/PostgreSQL pour ses données métier.
# Ces variables ne doivent être ajoutées que si un module Appwrite serveur est activé.
# Ne jamais exposer APPWRITE_API_KEY dans un frontend Vite/Flutter.
# APPWRITE_ENDPOINT="https://appwrite.kernelforge.codes/v1"
# APPWRITE_PROJECT_ID="6a959096002a64d9d4e6"
# APPWRITE_API_KEY="CLE_API_SERVEUR_APPWRITE"
# APPWRITE_DATABASE_ID="uniflow"
# APPWRITE_STORAGE_BUCKET_ID="uniflow_assets"

# ==================== DÉVELOPPEMENT LOCAL ====================
# DATABASE_URL="postgresql://uniflow:uniflow_dev_password@localhost:5433/uniflow_dev"
# NODE_ENV=development
# CORS_ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173"
