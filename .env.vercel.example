# UniFlow Backend — variables Vercel Production
# Projet : uniflow-backend
# Domaine : https://api-uniflow.kernelforge.codes
# Remplacez toutes les valeurs marquées VOTRE_ avant l’enregistrement.
# Ne commitez jamais ce fichier avec de vraies clés.

NODE_ENV=production
PORT=3000

# PostgreSQL accessible depuis Vercel.
# Ne mettez pas un host Docker interne comme "postgres" ici.
DATABASE_URL="postgresql://VOTRE_UTILISATEUR:VOTRE_MOT_DE_PASSE@VOTRE_HOTE_PUBLIC:5432/VOTRE_BASE?sslmode=require"

# Secret JWT aléatoire long, différent du développement.
JWT_SECRET="VOTRE_SECRET_JWT_ALEATOIRE_64_CARACTERES_MINIMUM"

# Exactement 64 caractères hexadécimaux pour AES-256.
ENCRYPTION_KEY="VOTRE_CLE_AES_256_EN_HEX_64_CARACTERES"

# Domaines autorisés séparés par des virgules.
CORS_ALLOWED_ORIGINS="https://uniflow.kernelforge.codes,https://api-uniflow.kernelforge.codes"

# Appwrite Storage — bucket existant UniFlow.
APPWRITE_ENDPOINT="https://appwrite.kernelforge.codes/v1"
APPWRITE_PROJECT_ID="6a959096002a64d9d4e6"
APPWRITE_API_KEY="VOTRE_CLE_API_SERVEUR_APPWRITE"
APPWRITE_STORAGE_BUCKET_ID="uniflow_assets"

# APPWRITE_DATABASE_ID="uniflow"
